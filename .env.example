# Copy to .env and adjust. NOTE: the app does NOT auto-load this file — featuregen.config and the
# flag gates read os.environ directly, and `make api` does not source it. Export these into the
# environment before launching, e.g.  set -a && source .env && set +a && make api  (the demo
# launcher ./run-demo.sh does exactly this for .env.demo). The test harness reads the variables.

# Runtime database (the event store, outbox, timers, projections, etc.).
FEATUREGEN_DSN=postgresql://localhost:5432/featuregen

# MIGRATIONS: the schema is NOT auto-applied by default. After pulling code that adds a migration,
# run `python -m featuregen migrate` — otherwise endpoints touching the new schema return 500 and the
# API logs "DATABASE SCHEMA IS BEHIND THE CODE" at startup. Set FEATUREGEN_AUTO_MIGRATE=1 to have the
# API auto-apply pending migrations on startup (convenient for dev/demo; keep it a deliberate step in
# production).
# FEATUREGEN_AUTO_MIGRATE=1

# Test database. If set, the test suite uses this server; if unset, it spins up an
# ephemeral PostgreSQL cluster via pytest-postgresql.
FEATUREGEN_TEST_DSN=postgresql://localhost:5432/featuregen_test

# Verifier-held HMAC key for the tamper-evident security-audit chain (§6.2). REQUIRED in
# production: security.audit fails closed and refuses to sign the chain if this is unset
# (a keyless hash would be forgeable by any writer). Keep it out of the database; rotate via
# your secrets manager. The test harness sets a deterministic key automatically.
FEATUREGEN_AUDIT_HMAC_KEY=change-me-to-a-high-entropy-secret

# ── LLM provider (optional) ────────────────────────────────────────────────────────────────────
# Wires the config-gated Claude adapter. Unset: uploads ingest UN-enriched (no concept/definition/
# domain), Pass B is skipped, and feature-assist endpoints return 503 — no fake AI (Decision D5).
# FEATUREGEN_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Default model for every LLM call (enrichment + Pass B); overridable per deployment. Default sonnet.
# FEATUREGEN_LLM_MODEL=claude-sonnet-5
# FEATUREGEN_LLM_MAX_TOKENS=4096   FEATUREGEN_LLM_THINKING=adaptive   FEATUREGEN_LLM_EFFORT=high
# Per-CALL wall-clock ceiling in seconds (MF-4), default 300 — EQUAL to the manifest by test
# (test_the_CODE_DEFAULT_timeout_is_the_one_the_manifest_ships). This bounds each PHYSICAL provider
# attempt, and since the Anthropic client is built with max_retries=0 it is the whole elapsed clock
# of one call. One LOGICAL call may still issue up to five physical ones (1 + 2 truncation retries
# + 2 repairs), and a truncation retry scales this clock by the same ratio it raises max_tokens —
# so the worst-case chain is this value x (1 + 4 x that ratio), held under the source advisory lock.
# The ratio is FEATUREGEN_LLM_MAX_TOKENS-dependent and caps at 64000/FEATUREGEN_LLM_MAX_TOKENS, so
# a SMALLER max_tokens means a LONGER worst case. Raise this together with
# OVERLAY_ENRICH_STAGE_DEADLINE_S, never alone.
# FEATUREGEN_LLM_TIMEOUT=300
# Per-stage ceiling on PHYSICAL provider calls in a batched enrichment run, default 512 (a count
# bound, not a time bound — the stage deadline still governs how long a run may hold the lock).
# PER STAGE, not per upload: one ledger is built per run_batched invocation.
# A wide catalog needs more: summary/synonyms run over EVERY column at 8 items per chunk.
# It is a RUNAWAY BACKSTOP — crossing it does not slow a stage down, it stops enriching columns —
# so it is set above any legitimate chunking outcome (237 items x 2 attempts + 8 fallbacks = 482)
# and the wall clock above, not this number, is the operational cost bound.
# OVERLAY_ENRICH_MAX_PROVIDER_CALLS=512
# Wall-clock ceiling for one enrichment STAGE, default 240s. Past it the stage stops ISSUING new
# chunks; it cannot interrupt a call already in flight, so the real lock hold is this plus one
# worst-case logical call as computed above.
# OVERLAY_ENRICH_STAGE_DEADLINE_S=1800

# ── Governed passes (all default OFF; the base upload→graph→evidence path is always on) ──────────
# Pass C — deterministic single-column join DISCOVERY. Implies governed-join routing on its own, so
# you do NOT also need OVERLAY_GOVERNED_JOINS. Proposals require two DISTINCT platform-admins to VERIFY.
# OVERLAY_PASS_C=1
# Governed-join routing for DECLARED CSV joins WITHOUT Pass C discovery (redundant if Pass C is on).
# OVERLAY_GOVERNED_JOINS=1
# Pass B — LLM-proposed table grain / availability_time (single-confirmer). Needs the LLM provider above.
# OVERLAY_TABLE_SYNTH=1
# Dev auth stub: routes read X-User / X-Roles headers instead of a real session.
# FEATUREGEN_AUTH_STUB=1
# ── Release-A flags (verified-interfaces D8; both default OFF; truthy: 1/true/yes/on) ────────────
# Richer feature-generation context (v2+ payload shape). Off = the thin v1 menu, byte-for-byte.
# FEATUREGEN_FEATURE_CONTEXT=1
# THE ROLLBACK LEVER for the flag above, and the only one that is not a functional regression:
# with FEATUREGEN_FEATURE_CONTEXT on, this selects WHICH context contract egresses. Unset = v4 (the
# shared SemanticContextBundleV1 shape). Set it to 3 to return to the shipped v3 payload — smaller
# prompts, no concept ancestry / namespace / party role / authority axes — WITHOUT dropping to the
# thin v1 menu, which turning the flag off would do. Only 3 and 4 are honoured; anything else warns
# and uses the default. Left commented so the incident lever is a value change, never a new key
# somebody has to invent under pressure.
# FEATUREGEN_FEATURE_CONTEXT_VERSION=3
# Dataset/catalog semantic profiles: profile API surfaces (GET/PUT /catalogs/{source}/profile,
# /catalog/asset-profiles/...), the optional catalog_profile_json upload part, and catalog display
# names in GET /catalogs. Off = every new surface 404s; existing payloads stay byte-identical.
# FEATUREGEN_DATASET_PROFILES=1
# Release-B source/temporal selection: the serving/temporal policy surfaces
# (/catalog/dataset-policies/...) and the decision contracts behind them. Off = those routes 404.
# DEPENDS ON FEATUREGEN_DATASET_PROFILES=1 and is FAIL-CLOSED (verified-interfaces D8): setting this
# alone is an invalid configuration — the feature stays disabled, its routes keep 404ing, and the
# app logs a loud warning at startup rather than running a half-enabled path.
# FEATUREGEN_SOURCE_TEMPORAL_SELECTION=1
# Release-C two-leg mapping-table crosswalk EXECUTION: compiling and rendering a governed
# source -> mapping -> target traversal into the generated Kedro/PySpark project. Off = crosswalks
# stay discoverable and visible everywhere they are today and are structurally non-executable.
# DEPENDS ON FEATUREGEN_SOURCE_TEMPORAL_SELECTION being ENABLED (which itself requires
# FEATUREGEN_DATASET_PROFILES=1). Unlike the flag above this dependency is a TRUE BOOT REFUSAL
# (verified-interfaces D8): setting this one alone makes the app refuse to start, because a
# crosswalk's mapping rows are chosen by the Release-B temporal policy and without it the row rule
# is one nobody resolved. Truthy: 1/true/yes/on.
# FEATUREGEN_CROSSWALK_EXECUTION=1
# 3B.3c kill-switch: set to 1 to have the shadow planner also COMPILE binding contracts (log-only; default off).
# FEATUREGEN_INTENT_CONTRACT_COMPILE=1
# 3B.4 shadow telemetry: set to 1 to PERSIST the shadow planner's classifications (manifest + run +
# plan tables, WORM) for the 3C-enablement gate. Independent of the compile flag; default off (no writes).
# FEATUREGEN_INTENT_SHADOW_TELEMETRY=1
# 3B.4 gate signature: the TRUSTED PUBLIC key (PEM) verifiers/CI use to check the 3C-enablement-gate
# artifact's ed25519 DETACHED signature. The PRIVATE half is held by a separate signing authority, NOT
# here. Fail-closed: verification refuses when unset. (Public key — safe to distribute, never the private.)
# FEATUREGEN_INTENT_GATE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# 3C.1 gate operationalization: the producing code version stamped on each shadow run (the cohort a
# gate window selects over). Set at deploy, e.g. the git SHA. Unset -> "unset" (uncertified, excluded).
# FEATUREGEN_PRODUCER_COMMIT=<git-sha>
# 3C.2a live governed cross-catalog (the first customer-facing flip). NECESSARY BUT NOT SUFFICIENT:
# also requires a matching non-revoked PASS activation decision for this deployment + version vector.
# FEATUREGEN_INTENT_LIVE_CROSS_CATALOG=1
# A stable per-deployment identity; activation approval is keyed by deployment_id + version vector so a
# copied env / shared DB cannot inherit another deployment's approval.
# FEATUREGEN_DEPLOYMENT_ID=production-eu
# Frontend: enable the internal gate-evaluation admin console (platform-admin only).
# VITE_INTENT_GATE_CONSOLE=1
# Feature generation scope authority. The safe default is confirmation_required: recognition and a
# human-confirmed taxonomy scope are mandatory before recipe generation. legacy_unscoped is an
# emergency compatibility mode and is reported by /health and /metrics.
FEATUREGEN_SCOPE_EXECUTION_MODE=confirmation_required

# ── Materialization / code-gen (Phase G; default OFF) ────────────────────────────────────────────
# THE KILL SWITCH for the whole materialization lane. Compiling a governed feature group into a
# sealed Kedro project runs INSIDE the worker tick on the worker's one connection, so while a
# compile runs the relay, the timers, the projections and every poller wait for it. Set to 0 (or
# unset) and the worker claims no further compile — which is NOT the same act as stopping the
# worker, since everything else it drives keeps running. Nothing caches the value, so the first tick
# after a process sees the change obeys it (a container reads its environment at start, so there
# that means restarting the pod). Queued jobs are preserved, not discarded: they stay `ready` and
# drain when it goes back on. Off costs a deployment nothing at all — no query, no counter, no log
# line. Truthy: 1/true/yes/on.
FEATUREGEN_MATERIALIZE_ENABLED=0
# The directory a sealed project tree is written under, one subdirectory per generation. REQUIRED
# when the switch is on — there is no safe default, so an unset value leaves the request queued and
# names the variable rather than failing it. That patience is FINITE, and this is the likeliest
# first-enable mistake: a missing setting is retryable, so the job is redelivered on the queue's
# ordinary budget (12 attempts) and then DEAD-LETTERED. The lane never claimed the request, so it
# writes no lifecycle either — the request is stranded at `requested` with nothing queued behind it,
# and re-triggering past that point needs a FRESH idempotency key (the old one names the stranded
# request, and the API answers 409). Set this WITH the switch, not after it.
# FEATUREGEN_MATERIALIZE_PROJECT_ROOT=/var/lib/featuregen/materialize
# Path to the YAML file of CAPTURED CLUSTER FACTS (environment id, engine versions, table layouts) a
# human wrote — §0's typed input to every compilation. REQUIRED when the switch is on; nothing can
# infer it. See src/featuregen/materialize/inventory.py for the shape.
# FEATUREGEN_MATERIALIZE_INVENTORY=/etc/featuregen/cluster-inventory.yaml
# The python interpreter used for the L0 BUILD PROOF (a subprocess that imports the generated
# project). Unset is an honest POSTURE, not a missing setting: every run then records "the build was
# never proven" and terminates truthfully. Set it only to an interpreter that has kedro installed.
# FEATUREGEN_MATERIALIZE_L0_PYTHON=/opt/kedro-venv/bin/python
# The bound on that build proof, in seconds. REQUIRED whenever L0_PYTHON is set (a bound inherited
# by omission is a bound nobody decided), and the worker's lease is DERIVED from it, so raising this
# raises the lease structurally.
# FEATUREGEN_MATERIALIZE_L0_TIMEOUT_SECONDS=900
#
# ── THE EXECUTION BLOCK (G-2/G-3): eight variables, ALL of them or NONE ──────────────────────────
# Everything above compiles, renders, seals and proves a BUILD; none of it executes a run. These
# eight become the metastore adapter (L1's three questions), the publication swap (§10.3's one
# atomic pointer switch), the submitter and §9's staging base. Unset — the default — is an OUTCOME:
# every run is recorded RUN_FAILED at PREPARE_RUN naming what the deployment did not configure.
# Setting only some of them is neither posture, and the lane refuses at the first claimed job with
# the missing names.
#
# EIGHT VARIABLES AND NOT ONE DSN, deliberately: a connection string has a password slot, and none
# of these can hold a credential (data_agent/connection.py's rule — "a field that could hold a
# secret eventually holds one").
#
# Which SQL dialect the endpoint speaks. Closed vocabulary; `hive` is the only member and it covers
# HiveServer2 and the Spark Thrift Server.
# FEATUREGEN_MATERIALIZE_METASTORE_ENGINE=hive
# Where that endpoint is. It must be the ENGINE's SQL endpoint: reaching the metastore's backing
# database is not reaching the metastore, and the pointer switch has to be the engine's own atomic
# operation because that is what §10.3's probe attests.
# These two values ARE the kind sandbox's Service — `deploy/kind/sandbox/41-spark-thrift.yaml`
# deploys a Spark Thrift Server as a ClusterIP Service named `spark-thrift` on port 10000, in front
# of the same catalog and on the same image as `40-spark.yaml`. Opt-in via
# `bash deploy/kind/sandbox/up.sh`; `deploy.sh` never applies it.
# FEATUREGEN_MATERIALIZE_METASTORE_HOST=spark-thrift
# FEATUREGEN_MATERIALIZE_METASTORE_PORT=10000
# How the client authenticates (passed to the driver upper-cased), and the account the metadata
# reads AND the swap run as. The principal is evidence: two reads under two principals are not
# interchangeable. `NONE` matches the sandbox endpoint, where it is the only runnable mode (no
# `javac` for a CUSTOM provider, no LDAP server, no KDC, no PAM libraries) — a real cluster sets
# what its endpoint enforces.
# FEATUREGEN_MATERIALIZE_METASTORE_AUTH=NONE
# FEATUREGEN_MATERIALIZE_METASTORE_PRINCIPAL=featuregen
# L1 ALSO asks *may these roles read this table* (`SHOW GRANT ROLE … ON TABLE …`), which needs
# SQL-standard authorization. A Spark Thrift Server CANNOT answer it — Spark's grammar rejects
# `SHOW GRANT` as an unsupported Hive native command — so against the sandbox endpoint the adapter
# raises `MetastoreReadScopeUnanswerable` rather than guessing, and L1 does not pass. That is a
# property of the engine, not a missing setting.
# §9's staging root BASE — <base>/<generation_id> per run, and the rendered project writes its
# immutable versioned output at <staging_root>/published/<table>, which is where the swap points.
# FEATUREGEN_MATERIALIZE_STAGING_BASE=/warehouse/staging
# The interpreter that RUNS the artifact, and its bound in seconds. NOT the same thing as
# L0_PYTHON: proving a project builds needs no JVM, running it does.
# FEATUREGEN_MATERIALIZE_SUBMIT_PYTHON=/opt/kedro-venv/bin/python
# FEATUREGEN_MATERIALIZE_SUBMIT_TIMEOUT_SECONDS=3600
