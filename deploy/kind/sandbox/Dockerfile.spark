# Spark 3.5 for the local materialization sandbox.
#
# 3.5 is deliberate, not the newest available. Spark 3 defaults `spark.sql.ansi.enabled` to FALSE
# and Spark 4 defaults it TRUE, which changes what a decimal overflow and a divide-by-zero DO —
# return NULL versus raise. The rendered pipeline's OVERFLOW_VIOLATION gate is built for the NULL
# behaviour, so a sandbox on 4.x would exercise different arithmetic than the target cluster and
# report confident results under the wrong semantics.
#
# WHY NOT `apache/spark:3.5.3`. That image ships Python 3.8.10, and the renderer targets kedro 1.5
# (what Task 12 verified its emitted API against), which requires Python >= 3.9 — `pip install
# kedro==1.5.0` there resolves no candidate above 0.19.8. So the stock Spark image cannot run the
# project this repo generates. Building on Python 3.11 with PySpark from PyPI gives the same Spark
# 3.5 runtime on a Python new enough for the pinned Kedro, and matches the `.venv-l0` combination
# already known to build the rendered pipeline.
#
# NOTE FOR TASK 0: `EngineVersions` carries `python` AND `kedro`, and this is exactly why they are
# both required. If the target cluster's Spark 3.5 runs Python 3.8, the generated project's Kedro
# pin is unusable there and the inventory must say so before a run is attempted, not after.
# Pinned to bookworm on purpose: the floating `python:3.11-slim` tag has moved to a Debian release
# that dropped `openjdk-17-jre-headless` in favour of 21, and Spark 3.5 supports Java 8/11/17 —
# not 21. An unpinned base would have silently changed the JVM under the engine.
FROM python:3.11-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl procps \
 && rm -rf /var/lib/apt/lists/*

# PySpark bundles the Spark distribution, so this is the engine as well as the client.
RUN pip install --no-cache-dir --timeout 120 --retries 5 \
      "pyspark==3.5.3" "kedro==1.5.0" "kedro-datasets[spark]==9.5.0"

# Spark's built-in Hive metastore client talks to Postgres directly (no separate metastore
# service): the shared RDBMS is what lets several sessions see one catalog. The driver is baked in
# rather than resolved with --packages so a run never depends on Maven being reachable.
ARG PG_JDBC_VERSION=42.7.4
RUN SPARK_JARS="$(python -c 'import pyspark,os;print(os.path.join(os.path.dirname(pyspark.__file__),"jars"))')" \
 && curl -fsSL -o "$SPARK_JARS/postgresql-${PG_JDBC_VERSION}.jar" \
      "https://repo1.maven.org/maven2/org/postgresql/postgresql/${PG_JDBC_VERSION}/postgresql-${PG_JDBC_VERSION}.jar"

# Re-fetch of the Hive client jars, kept as a belt-and-braces pin.
#
# CORRECTION (SUCCESSOR 3, verified): the comment that used to sit here said Hive metastore support
# "is not in the base pyspark wheel's jar set" and that without this step the catalog silently falls
# back to in-memory. **That is false.** The pyspark 3.5.3 distribution already bundles all four —
# `hive-metastore-2.3.9.jar`, `hive-exec-2.3.9-core.jar`, `hive-common-2.3.9.jar`,
# `hive-serde-2.3.9.jar` — under the SAME names this loop writes. Verified by listing the members of
# `pyspark-3.5.3.tar.gz` (the 3.5.x line publishes an sdist, not a wheel). The real cause of the
# silent-Derby symptom is the one `40-spark.yaml` documents: `SPARK_CONF_DIR`, without which the
# mounted spark-defaults.conf is never read at all. This step is therefore redundant rather than
# load-bearing, and it is kept (not deleted) only because it pins the exact versions if a future
# pyspark bump changes what is bundled — which is also why it still ends `|| true`.
RUN SPARK_JARS="$(python -c 'import pyspark,os;print(os.path.join(os.path.dirname(pyspark.__file__),"jars"))')" \
 && for c in hive-metastore/2.3.9 hive-exec/2.3.9 hive-common/2.3.9 hive-serde/2.3.9; do \
      n="${c%%/*}"; v="${c##*/}"; \
      curl -fsSL -o "$SPARK_JARS/${n}-${v}-core.jar" \
        "https://repo1.maven.org/maven2/org/apache/hive/${n}/${v}/${n}-${v}-core.jar" \
      || curl -fsSL -o "$SPARK_JARS/${n}-${v}.jar" \
        "https://repo1.maven.org/maven2/org/apache/hive/${n}/${v}/${n}-${v}.jar"; \
    done || true

# THE ENDPOINT'S PRECONDITION, ASSERTED AT BUILD TIME — see deploy/kind/sandbox/41-spark-thrift.yaml.
#
# That manifest starts a Spark Thrift Server by `spark-submit`-ing one class, because the PyPI
# distribution ships NO `sbin/start-thriftserver.sh` (its `sbin/` holds exactly four scripts:
# spark-config.sh, spark-daemon.sh, start-history-server.sh, stop-history-server.sh — verified
# against pyspark 3.5.3's own sdist). Everything that invocation needs is checked HERE so a missing
# piece fails `docker build` on the operator's laptop, rather than becoming a CrashLoopBackOff whose
# cause is a stack trace inside a JVM launcher.
#
# Both halves are asserted because they fail differently: a missing `spark-submit` is a container
# that exits instantly, while a missing thriftserver jar is a launcher that starts and then dies on
# ClassNotFoundException — the second is the one nobody diagnoses quickly.
RUN command -v spark-submit >/dev/null \
      || { echo "FATAL: spark-submit is not on PATH; 41-spark-thrift.yaml cannot start" >&2; exit 1; } \
 && SPARK_JARS="$(python -c 'import pyspark,os;print(os.path.join(os.path.dirname(pyspark.__file__),"jars"))')" \
 && ls "$SPARK_JARS"/spark-hive-thriftserver_*.jar >/dev/null 2>&1 \
      || { echo "FATAL: no spark-hive-thriftserver jar in $SPARK_JARS — the Thrift endpoint's class" \
                "org.apache.spark.sql.hive.thriftserver.HiveThriftServer2 would not resolve" >&2; exit 1; }

WORKDIR /work
